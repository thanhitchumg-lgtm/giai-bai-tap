# Sao chép file này thành ".env" rồi dán API key của bạn vào.
# Dòng bắt đầu bằng dấu # là ghi chú, sẽ bị bỏ qua.
GEMINI_API_KEY=dan_api_key_cua_ban_vao_day

# ---- Tùy chọn (muốn đổi thì xóa dấu # ở đầu dòng) ----
# Model cho từng chế độ giải:
# MODEL_FAST=gemini-3.1-flash-lite
# MODEL_BALANCED=gemini-3.7-flash
# MODEL_ACCURATE=gemini-3.8-flash

# Mức "suy nghĩ" của model: minimal, low, medium, high hoặc default.
# Thấp hơn = nhanh hơn. Lưu ý: gemini-3.8-flash không nhận "minimal".
# THINKING_FAST=minimal
# THINKING_BALANCED=low
# THINKING_ACCURATE=medium

# Chế độ mặc định khi mở trang: fast, balanced hoặc accurate
# DEFAULT_MODE=fast

# PORT=3000
# RATE_LIMIT_PER_MIN=10
# TIMEOUT_SECONDS=60
